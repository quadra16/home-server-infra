## DuckDNS configuration for the DNS updater container
# Get your token from https://www.duckdns.org after logging in
TOKEN=your-duckdns-token-here

# Your DuckDNS subdomain (just the prefix, not the full domain)
DUCKDNS_SUBDOMAIN=yoursubdomain

# Tailscale IP of this machine (run: tailscale ip -4)
TAILSCALE_IP=100.x.x.x
